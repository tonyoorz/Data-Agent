      "y": 320,
      "width": 200,
      "height": 140
    },
    {
      "id": "w2",
      "type": "text",
      "text": "## W2 清理 draft\n核心 10 指标 approved\n其余挂决策单",
      "x": -160,
      "y": 320,
      "width": 200,
      "height": 140
    },
    {
      "id": "w3",
      "type": "text",
      "text": "## W3 可视化\n编译器输出 Mermaid\nObsidian 目录页",
      "x": 80,
      "y": 320,
      "width": 200,
      "height": 140
    },
    {
      "id": "w4",
