{
  "$id": "https://vizion-lab.local/ontology/schema/sources.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "ontologyVersion", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "ontologyVersion": { "const": "v1" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "system", "readModel", "revisionStrategy", "governance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
          "system": { "enum": ["analytics", "octane", "duplicate-search", "artifact"] },
          "database": { "type": "string" },
          "table": { "type": "string" },
          "readModel": { "type": "string", "minLength": 1 },
          "revisionStrategy": { "enum": ["snapshot", "watermark", "content_hash", "unknown"] },
          "freshnessSloMinutes": { "type": "integer", "minimum": 1, "maximum": 525600 },
          "governance": { "$ref": "common.schema.json#/$defs/governance" }
        }
      }
    }
  }
}
