{
  "schemaVersion": "1.0",
  "ontologyVersion": "v1",
  "actions": [
    {
      "id": "octane.defect.add_comment",
      "version": "0.1.0",
      "labels": {
        "zh-CN": "添加缺陷评论",
        "en-US": "Add Defect Comment"
      },
      "description": "Draft action for posting a governed comment to an Octane defect. The current system supports dry-run preview and explicit apply through the duplicate-comment workflow, but this ontology action is not approved for autonomous execution.",
      "targetEntityId": "quality.defect",
      "operation": "comment",
      "capabilityState": "dry_run_only",
      "intentHints": [
        "add comment",
        "post comment",
        "write comment",
        "添加评论",
        "写评论",
        "duplicate analysis comment"
      ],
      "fieldBindings": [
        {
          "fieldId": "octane_defects.table_column.defect_id",
          "role": "target",
          "localPropertyId": "defect_id",
          "required": true
        },
        {
          "fieldId": "octane_defects.table_column.comments",
          "role": "editable",
          "localPropertyId": "comments",
          "required": true
        }
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "defect_id",
          "comment_html",
          "rationale"
        ],
        "properties": {
          "defect_id": {
            "type": "string"
          },
          "comment_html": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      },
      "apiBinding": {
        "system": "octane",
        "sourceId": "analytics.full_picture_defects",
        "method": "POST",
        "endpointTemplate": "/api/shared_spaces/{sharedSpaceId}/workspaces/{workspaceId}/work_items/{defect_id}/comments"
      },
      "execution": {
        "mode": "dry_run_only",
        "executor": "backend.analytics_cli.post-duplicate-search-comment",
        "requiresDryRun": true,
        "requiresHumanApproval": true,
        "requiresActorScope": true,
        "sideEffects": [
          "comment_create",
          "octane_write",
          "audit_log"
        ]
      },
      "policies": [
        "actor.scope.mandatory"
      ],
      "audit": {
        "runAudit": true,
        "toolCallAudit": true,
        "externalRequestAudit": true,
        "rollbackStrategy": "manual"
      },
      "governance": {
        "status": "draft",
        "owner": "Agent Platform",
        "decisionRef": "docs/ontology/octane-field-catalog.md"
      }
    },
    {
      "id": "octane.defect.delete_work_item",
      "version": "0.1.0",
      "labels": {
        "zh-CN": "删除缺陷单",
        "en-US": "Delete Defect Work Item"
      },
      "description": "Blocked action documenting that destructive Octane defect deletion is outside autonomous agent capability. Keep this explicit so delete intents are routed to policy explanation instead of ad-hoc tool use.",
      "targetEntityId": "quality.defect",
      "operation": "delete",
      "capabilityState": "blocked",
      "intentHints": [
        "delete defect",
        "remove defect",
        "删除缺陷",
        "删除问题单"
      ],
      "fieldBindings": [
        {
          "fieldId": "octane_defects.table_column.defect_id",
          "role": "target",
          "localPropertyId": "defect_id",
          "required": true
        }
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "defect_id",
          "business_approval_ref"
        ],
        "properties": {
          "defect_id": {
            "type": "string"
          },
          "business_approval_ref": {
            "type": "string"
          }
        }
      },
      "apiBinding": {
        "system": "octane",
        "sourceId": "analytics.full_picture_defects",
        "method": "DELETE",
        "endpointTemplate": "/api/shared_spaces/{sharedSpaceId}/workspaces/{workspaceId}/work_items/{defect_id}"
      },
      "execution": {
        "mode": "blocked",
        "executor": "none",
        "requiresDryRun": true,
        "requiresHumanApproval": true,
        "requiresActorScope": true,
        "sideEffects": [
          "destructive_delete",
          "octane_write",
          "audit_log"
        ]
      },
      "policies": [
        "actor.scope.mandatory"
      ],
      "audit": {
        "runAudit": true,
        "toolCallAudit": true,
        "externalRequestAudit": true,
        "rollbackStrategy": "not_supported"
      },
      "governance": {
        "status": "draft",
        "owner": "Agent Security",
        "decisionRef": "docs/ontology/octane-field-catalog.md"
      }
    },
