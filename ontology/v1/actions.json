      ],
      "audit": {
        "runAudit": true,
        "toolCallAudit": true,
        "externalRequestAudit": true,
        "rollbackStrategy": "manual"
      },
      "governance": {
        "status": "draft",
        "owner": "Quality Governance",
        "decisionRef": "docs/ontology/octane-field-catalog.md"
      }
