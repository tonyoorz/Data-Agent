# Data-Agent Environment Configuration
# Copy to .env and fill in values

# ========================================================================
# Auth — OAuth Provider Configuration
# ========================================================================

# --- WeChat (微信开放平台 — 网站应用) ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:5173/login

# --- GitHub OAuth App ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/login

# ========================================================================
# Auth — JWT
# ========================================================================
# JWT_SECRET=  # Auto-generated if not set
ACCESS_TOKEN_EXPIRE_SECONDS=1800     # 30 min
REFRESH_TOKEN_EXPIRE_SECONDS=2592000 # 30 days

# ========================================================================
# LLM Providers
# ========================================================================
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# ========================================================================
# Agent Config
# ========================================================================
AGENT_LLM_PROVIDER=zhipu
AGENT_MODE=llm

# ========================================================================
# Main Agent Runtime (v2)
# ========================================================================
MAIN_AGENT_RUNTIME_MODE=legacy
MAIN_AGENT_IDENTITY_MODE=dev
VIZION_API_HOST=127.0.0.1
VIZION_DEV_HOST=127.0.0.1
MAIN_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:8080
MAIN_AGENT_RUNTIME_DB_PATH=database/runtime/runtime.sqlite
MAIN_AGENT_ARTIFACT_ROOT=database/runtime/artifacts
MAIN_AGENT_MODEL_RECORDS=[]
MAIN_AGENT_DEFAULT_MODEL=
