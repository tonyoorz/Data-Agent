          "octane_write",
          "audit_log"
        ]
      },
      "policies": [
        "actor.scope.mandatory"
      ],
      "audit": {
        "runAudit": true,
        "toolCallAudit": true,
        "externalRequestAudit": true,
        "rollbackStrategy": "manual"
      },
      "governance": {
        "status": "draft",
        "owner": "Quality Governance",
        "decisionRef": "docs/ontology/octane-field-catalog.md"
      }
    },
    {
      "id": "quality.defect.update_status",
      "version": "1.0.0",
      "labels": {
        "zh-CN": "更新缺陷状态",
        "en-US": "Update Defect Status"
      },
      "description": "Governed transactional writeback that updates a defect status (e.g. Open→Closed) through the two-phase approval flow.",
      "targetEntityId": "quality.defect",
      "operation": "update",
      "capabilityState": "available",
      "intentHints": [
        "关闭缺陷",
        "更新状态",
        "close defect",
        "update status"
      ],
      "fieldBindings": [
        {
          "fieldId": "octane_defects.table_column.defect_id",
          "role": "target",
          "localPropertyId": "defect_id",
          "required": true
        },
        {
          "fieldId": "octane_defects.table_column.status",
          "role": "editable",
          "localPropertyId": "status",
          "required": true
        }
      ],
      "mutation": {
        "fields": [
          "status",
          "resolution_time"
        ],
        "writeback": {
          "dataset": "analytics.defect_writeback",
          "transactional": true
        }
      },
      "submissionCriteria": [
        {
          "kind": "userGroup",
          "userGroup": "dtsv_team"
        },
        {
          "kind": "approval",
          "approvalKind": "defect_write",
          "ttlMin": 15
        }
      ],
      "inputSchema": {
        "type": "object",
        "required": [
          "defect_id",
          "status"
        ],
        "properties": {
          "defect_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "Closed",
              "Rejected",
              "In Progress"
            ]
          },
          "resolution_time": {
            "type": "string"
          }
        }
      },
      "apiBinding": {
        "system": "octane",
        "sourceId": "analytics.full_picture_defects",
        "method": "PATCH",
        "endpointTemplate": "/api/agent/actions/defect_writeback"
      },
      "execution": {
        "mode": "enabled",
        "executor": "server/agentRuntime/actionRuntime.mjs",
        "requiresDryRun": true,
        "requiresHumanApproval": true,
        "requiresActorScope": true,
        "sideEffects": [
          "field_update",
          "octane_write",
          "audit_log"
        ]
      },
      "policies": [
        "actor.scope.mandatory"
      ],
      "audit": {
        "runAudit": true,
        "toolCallAudit": true,
        "externalRequestAudit": true,
        "rollbackStrategy": "manual"
      },
      "governance": {
        "status": "approved",
        "owner": "Agent Platform",
        "decisionRef": "docs/plans/2026-08-16-agent-upgrade-program.md"
      }
    },
