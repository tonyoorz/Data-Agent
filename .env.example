# Data-Agent Environment Configuration
# Copy to .env and fill in values

# ========================================================================
# Auth — OAuth Provider Configuration
# ========================================================================

# --- WeChat (微信开放平台 — 网站应用) ---
# Apply at: https://open.weixin.qq.com/
# 1. Create a "网站应用" (Web Application)
# 2. Set 授权回调域名 = your domain (e.g., localhost:5173 for dev)
# 3. Get AppID and AppSecret
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:5173/login

# --- GitHub OAuth App ---
# Create at: https://github.com/settings/developers
# 1. New OAuth App
# 2. Authorization callback URL: http://localhost:5173/login
# 3. Get Client ID and Client Secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/login

# ========================================================================
# Auth — JWT
# ========================================================================
# Auto-generated if not set. For production, set a fixed strong secret.
# JWT_SECRET=

# Token expiry (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=1800     # 30 min
REFRESH_TOKEN_EXPIRE_SECONDS=2592000 # 30 days

# ========================================================================
# LLM Providers (existing)
# ========================================================================
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# ========================================================================
# Agent Config (existing)
# ========================================================================
AGENT_LLM_PROVIDER=zhipu
AGENT_MODE=llm
