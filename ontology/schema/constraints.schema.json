{
  "$id": "https://vizion-lab.local/ontology/schema/constraints.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "ontologyVersion", "constraints"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "ontologyVersion": { "const": "v1" },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "kind", "enforcement", "parameters", "governance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
          "version": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["query_limit", "approved_metric_only", "forbid_arbitrary_sql", "claim_evidence_binding", "similarity_not_statistic"] },
          "enforcement": { "enum": ["compile", "plan", "execute", "claim"] },
          "metricIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "dimensionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "relationshipIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "parameters": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
          "governance": { "$ref": "common.schema.json#/$defs/governance" }
        }
      }
    }
  }
}
