{
  "$id": "https://vizion-lab.local/ontology/schema/constraints.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "ontologyVersion", "constraints"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "ontologyVersion": { "const": "v1" },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "kind", "governance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
          "version": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "condition": { "type": "string" },
          "action": { "type": "string" },
          "enforcement": { "type": "string" },
          "metricIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "dimensionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "relationshipIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "parameters": { "type": "object" },
          "sourceDocuments": { "type": "array", "items": { "type": "string" } },
          "governance": { "$ref": "common.schema.json#/$defs/governance" }
        }
      }
    }
  }
}
