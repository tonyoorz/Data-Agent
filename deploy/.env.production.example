# ============================================================================
# Vizion Data-Agent — production environment (copy to deploy/.env.production)
# All variables are read by the Node app (loadLocalEnv) and the Python bridge.
# VITE_* are ALSO needed at BUILD time (inlined into dist) — pass them as
# --build-arg when building, or keep them here and they are harmless at runtime.
# ============================================================================

# ---- Ports / service discovery ----
VIZION_API_PORT=3004
VIZION_WEB_PORT=3004
VIZION_ANALYTICS_PORT=3003
# The app ONLY accepts a LOOPBACK analytics base (analyticsApiConfig.mjs rejects
# others). In every deployment mode analytics shares the app's network namespace,
# so this is always http://127.0.0.1:3003.
VIZION_ANALYTICS_API_BASE=http://127.0.0.1:3003

# ---- Auth ----
# internal = trust the LAN (no per-user login). For real SSO set mode=oidc and
# fill the VIZION_OIDC_* vars (see DEPLOYMENT.md). Pair with network ACLs.
VIZION_AGENT_AUTH_MODE=internal
VIZION_INTERNAL_ACTOR_ID=vizion-internal
# Broad internal scopes; tighten later if needed.
VIZION_INTERNAL_ALLOWED_OBJECT_TYPES=*

# ---- Embedding model (offline) ----
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
DUPLICATE_EMBEDDING_MODEL=/app/backend/cache/embedding_models/modelscope/BAAI/bge-small-zh-v1.5
# RapidOCR weights: if you pre-downloaded them, point here (offline). Otherwise
# the OCR feature downloads at first use (needs egress).
# DUPSEARCH_RAPIDOCR_DET_MODEL=/data/models/rapidocr/det.onnx
# DUPSEARCH_RAPIDOCR_REC_MODEL=/data/models/rapidocr/rec.onnx
# DUPSEARCH_RAPIDOCR_CLS_MODEL=/data/models/rapidocr/cls.onnx

# ---- Python bridge timeouts ----
DUPSEARCH_BRIDGE_SEARCH_TIMEOUT_MS=180000
DUPSEARCH_BRIDGE_REQUEST_TIMEOUT_MS=60000

# ---- Persistent state (volume /data) ----
VIZION_AGENT_CHECKPOINT_DB=/data/agent-checkpoints.db
VIZION_DATABASE_ROOT=/data/database

# ---- BMW internal LLM endpoint (REQUIRED for /api/ai/chat) ----
# Fill according to chatModelConfig.mjs expectations. Example shape:
# DUPSEARCH_CHAT_ACCESS_CODE=xxxxxxxx
# DUPSEARCH_CHAT_API_KEY=xxxxxxxx
# VIZION_LLM_BASE_URL=https://your-internal-llm-endpoint

# ---- Supabase (public anon key; inlined at build, repeated here for clarity) ----
VITE_SUPABASE_URL=https://muyrtwybdfjbglnbfeis.supabase.co
