        "properties": {
          "defect_id": {
            "type": "string"
          },
          "changes": {
            "type": "object"
          },
          "rationale": {
            "type": "string"
          }
        }
      },
      "apiBinding": {
        "system": "octane",
        "sourceId": "analytics.full_picture_defects",
        "method": "PUT",
        "endpointTemplate": "/api/shared_spaces/{sharedSpaceId}/workspaces/{workspaceId}/work_items/{defect_id}"
      },
      "execution": {
        "mode": "disabled",
        "executor": "none",
        "requiresDryRun": true,
